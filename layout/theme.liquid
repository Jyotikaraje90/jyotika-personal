<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%} CSS custom properties (inlined to avoid snippet-not-found errors on first deploy) {%- endcomment -%}
    {% style %}
      {%- if settings.type_primary_font -%}
        {{ settings.type_primary_font | font_face: font_display: 'swap' }}
        {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
        {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
        {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
      {%- endif -%}

      :root {
        {%- if settings.type_primary_font -%}
          --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
          --font-primary--style: {{ settings.type_primary_font.style }};
          --font-primary--weight: {{ settings.type_primary_font.weight }};
        {%- else -%}
          --font-primary--family: system-ui, sans-serif;
          --font-primary--style: normal;
          --font-primary--weight: 400;
        {%- endif -%}
        --page-width: {{ settings.max_page_width | default: '90rem' }};
        --page-margin: {{ settings.min_page_margin | default: 20 }}px;
        --color-background: {{ settings.background_color | default: '#ffffff' }};
        --color-foreground: {{ settings.foreground_color | default: '#333333' }};
        --style-border-radius-inputs: {{ settings.input_corner_radius | default: 4 }}px;
      }
    {% endstyle %}

    {%- comment -%} Font preloading — only when a Shopify-hosted font is selected {%- endcomment -%}
    {%- if settings.type_primary_font and settings.type_primary_font.system? == false -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endif -%}

    {%- comment -%} Google Fonts: Playfair Display (hero heading) + Nunito Sans (Proxima Nova fallback) {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
