<div class="hero-banner full-width">
  <div class="hero-banner__inner">

    {%- comment -%} Block 1: Main banner (left panel, full height) {%- endcomment -%}
    <div class="hero-banner__main">
      {%- if section.settings.main_image -%}
        <div class="hero-banner__main-bg">
          {{- section.settings.main_image | image_url: width: 1400 | image_tag: loading: 'eager', class: 'hero-banner__main-img' -}}
        </div>
      {%- endif -%}
      <div class="hero-banner__overlay"></div>
      <div class="hero-banner__content">
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-banner__heading">{{ section.settings.heading | newline_to_br }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="hero-banner__btn">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Block 2: Top right panel {%- endcomment -%}
    <div class="hero-banner__panel hero-banner__panel--top">
      {%- if section.settings.top_image -%}
        <div class="hero-banner__panel-bg">
          {{- section.settings.top_image | image_url: width: 600 | image_tag: loading: 'eager', class: 'hero-banner__panel-img' -}}
        </div>
      {%- endif -%}
      {%- if section.settings.top_label_1 != blank or section.settings.top_label_2 != blank -%}
        <div class="hero-banner__panel-text">
          {%- if section.settings.top_label_1 != blank -%}
            <span class="hero-banner__panel-line">{{ section.settings.top_label_1 }}</span>
          {%- endif -%}
          {%- if section.settings.top_label_2 != blank -%}
            <span class="hero-banner__panel-line">{{ section.settings.top_label_2 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Block 3: Bottom right panel {%- endcomment -%}
    <div class="hero-banner__panel hero-banner__panel--bottom">
      {%- if section.settings.bottom_image -%}
        <div class="hero-banner__panel-bg">
          {{- section.settings.bottom_image | image_url: width: 600 | image_tag: loading: 'eager', class: 'hero-banner__panel-img' -}}
        </div>
      {%- endif -%}
      {%- if section.settings.bottom_label_1 != blank or section.settings.bottom_label_2 != blank -%}
        <div class="hero-banner__panel-text">
          {%- if section.settings.bottom_label_1 != blank -%}
            <span class="hero-banner__panel-line">{{ section.settings.bottom_label_1 }}</span>
          {%- endif -%}
          {%- if section.settings.bottom_label_2 != blank -%}
            <span class="hero-banner__panel-line">{{ section.settings.bottom_label_2 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .hero-banner {
    padding: 0;
  }

  .hero-banner__inner {
    position: relative;
    max-width: 1800px;
    height: 829px;
    background-color: #000000;
    border-radius: 20px;
    overflow: hidden;
    display: grid;
    /* Right panels fixed at 514px; main panel takes the rest minus 1px gap */
    grid-template-columns: calc(100% - 514px) 514px;
    grid-template-rows: 414px 415px;
    margin: 0 auto;
  }

  /* ── Main Banner ────────────────────────────────────────────── */
  .hero-banner__main {
    grid-column: 1;
    grid-row: 1 / span 2;
    position: relative;
    overflow: hidden;
    /* 1px left offset reveals the container's black background as a divider */
    margin-left: 1px;
  }

  .hero-banner__main-bg {
    position: absolute;
    inset: 0;
  }

  .hero-banner__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Gradient overlay: black at top fading to transparent */
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #000000 0%, rgba(0, 0, 0, 0) 100%);
    opacity: 0.7;
  }

  /* Content frame: top: 80px, left: 61px, width: 964px, gap: 20px */
  .hero-banner__content {
    position: absolute;
    top: 80px;
    left: 61px;
    width: 964px;
    max-width: calc(100% - 61px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 1;
  }

  /* H1: Playfair Display 700, 64px/83px, uppercase, white */
  .hero-banner__heading {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-style: normal;
    font-size: 64px;
    line-height: 83px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    padding: 0;
    width: 964px;
    max-width: 100%;
  }

  /* H2 / subheading: Proxima Nova 400, 18px/29px, white */
  .hero-banner__subheading {
    font-family: 'Proxima Nova', 'Nunito Sans', 'Open Sans', Arial, sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 18px;
    line-height: 29px;
    letter-spacing: 0;
    color: #ffffff;
    margin: 0;
    padding: 0;
  }

  /* Button: 250×55px, white bg, border-radius: 8px, padding: 16px 32px */
  .hero-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 250px;
    height: 55px;
    background-color: #ffffff;
    color: #000000;
    border-radius: 8px;
    padding: 16px 32px;
    text-decoration: none;
    font-family: 'Proxima Nova', 'Nunito Sans', 'Open Sans', Arial, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1;
    box-sizing: border-box;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .hero-banner__btn:hover {
    opacity: 0.85;
  }

  /* ── Side Panels ────────────────────────────────────────────── */
  .hero-banner__panel {
    position: relative;
    overflow: hidden;
  }

  .hero-banner__panel--top {
    grid-column: 2;
    grid-row: 1;
    /* border-top-right-radius handled by parent overflow:hidden + border-radius */
  }

  .hero-banner__panel--bottom {
    grid-column: 2;
    grid-row: 2;
  }

  .hero-banner__panel-bg {
    position: absolute;
    inset: 0;
  }

  .hero-banner__panel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Panel text: top: 307px, left: 50px, gap: 13px */
  .hero-banner__panel-text {
    position: absolute;
    top: 307px;
    left: 50px;
    display: flex;
    flex-direction: column;
    gap: 13px;
    z-index: 1;
  }

  .hero-banner__panel-line {
    display: block;
    color: #ffffff;
    font-family: 'Proxima Nova', 'Nunito Sans', 'Open Sans', Arial, sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 22px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media screen and (max-width: 1200px) {
    .hero-banner__inner {
      grid-template-columns: calc(100% - 360px) 360px;
    }
    .hero-banner__heading {
      font-size: 48px;
      line-height: 62px;
      width: 100%;
    }
    .hero-banner__content {
      width: 85%;
      max-width: calc(100% - 61px);
    }
  }

  @media screen and (max-width: 900px) {
    .hero-banner__inner {
      height: auto;
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .hero-banner__main {
      grid-column: 1;
      grid-row: 1;
      min-height: 480px;
      margin-left: 0;
    }
    .hero-banner__panel--top {
      grid-column: 1;
      grid-row: 2;
      height: 280px;
    }
    .hero-banner__panel--bottom {
      grid-column: 1;
      grid-row: 3;
      height: 280px;
    }
    .hero-banner__panel-text {
      top: 210px;
    }
    .hero-banner__heading {
      font-size: 36px;
      line-height: 46px;
    }
  }

  @media screen and (max-width: 600px) {
    .hero-banner__content {
      top: 40px;
      left: 24px;
      max-width: calc(100% - 48px);
    }
    .hero-banner__heading {
      font-size: 28px;
      line-height: 36px;
    }
    .hero-banner__subheading {
      font-size: 15px;
      line-height: 24px;
    }
    .hero-banner__btn {
      width: 200px;
      height: 48px;
      font-size: 15px;
    }
    .hero-banner__panel-text {
      top: auto;
      bottom: 24px;
      left: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Main Banner"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Background image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Self Expression\nwith Puerto Ink"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The #1 Tattoo and Piercing Studio. From Heraklion to Antwerp, Amsterdam, and soon in Athens."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a Session"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Top Right Panel"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Panel image"
    },
    {
      "type": "text",
      "id": "top_label_1",
      "label": "Text line 1"
    },
    {
      "type": "text",
      "id": "top_label_2",
      "label": "Text line 2"
    },
    {
      "type": "header",
      "content": "Bottom Right Panel"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Panel image"
    },
    {
      "type": "text",
      "id": "bottom_label_1",
      "label": "Text line 1"
    },
    {
      "type": "text",
      "id": "bottom_label_2",
      "label": "Text line 2"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
